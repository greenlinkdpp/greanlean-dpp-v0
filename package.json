{
  "name": "greanlean-dpp-v0",
  "version": "0.1.0",
  "private": true,
  "overrides": {
    "fast-uri": "3.1.6",
    "nanoid": "3.3.18",
    "postcss": "8.5.23"
  },
  "scripts": {
    "dev": "next dev",
    "dev:v2": "node scripts/assert-development-target.mjs && NODE_USE_ENV_PROXY=1 node --env-file=.env.development.local node_modules/next/dist/bin/next dev",
    "guard:development": "node scripts/assert-development-target.mjs",
    "verify:v2:development": "node scripts/verify-v2-phase1-development.mjs",
    "verify:v2:phase2": "node scripts/verify-v2-phase2-development.mjs",
    "verify:v2:phase3": "node scripts/verify-v2-phase3-development.mjs",
    "verify:v2:phase4": "node scripts/verify-v2-phase4-development.mjs",
    "verify:v2:phase5": "node scripts/verify-v2-phase5-development.mjs",
    "verify:v2:phase6:evidence": "node --experimental-strip-types scripts/phase6/collect-readiness-evidence.mjs --output docs/v2-implementation/phase-6/evidence/readiness-evidence.json",
    "verify:v2:phase6:performance": "node scripts/phase6/measure-development-performance.mjs --output docs/v2-implementation/phase-6/evidence/development-performance.json",
    "verify:v2:phase6b:production": "node scripts/phase6b/collect-production-closure.mjs --output docs/v2-implementation/phase-6b/evidence/production-closure.json",
    "verify:v2:phase6b:stage1-production": "node scripts/phase6b/collect-stage1-production-baseline.mjs --output docs/v2-implementation/phase-6b/evidence/stage1-production-baseline.json",
    "verify:v2:phase6b:stage1-development": "node scripts/phase6b/collect-stage1-development-baseline.mjs --output docs/v2-implementation/phase-6b/evidence/stage1-development-baseline.json",
    "build": "next build",
    "start": "next start",
    "lint": "node scripts/lint.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --no-warnings --experimental-strip-types --test tests/unit/*.test.ts tests/integration/*.test.mjs",
    "test:unit": "node --no-warnings --experimental-strip-types --test tests/unit/*.test.ts",
    "test:integration": "node --test tests/integration/*.test.mjs",
    "test:migrations": "node --test tests/migrations/*.test.mjs",
    "test:smoke": "node scripts/smoke-test.mjs",
    "generate:battery-test": "node scripts/battery/generate_lmt_test_dataset.mjs",
    "bundle:battery-sql": "node scripts/database/build_battery_preview_bundle.mjs",
    "bundle:backoffice-phase1-sql": "node scripts/database/build_backoffice_alignment_phase1_bundle.mjs",
    "bundle:backoffice-phase2-sql": "node scripts/database/build_backoffice_alignment_phase2_bundle.mjs",
    "bundle:backoffice-phase3-sql": "node scripts/database/build_backoffice_alignment_phase3_bundle.mjs",
    "bundle:backoffice-phase4-sql": "node scripts/database/build_backoffice_alignment_phase4_bundle.mjs",
    "bundle:backoffice-phase5-sql": "node scripts/database/build_backoffice_alignment_phase5_bundle.mjs",
    "bundle:p0-sql": "node scripts/database/build_p0_battery_pilot_bundle.mjs",
    "bundle:battery-regulatory-v2-sql": "node scripts/database/build_battery_regulatory_v2_bundle.mjs",
    "compare:dpp-publications": "node --env-file=.env.local --experimental-strip-types scripts/dpp/compare_publication_candidates.ts",
    "test:all": "npm run lint && npm run typecheck && npm run test && npm run test:migrations && npm run build"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.0",
    "@supabase/supabase-js": "^2.45.4",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "clsx": "^2.1.1",
    "exceljs": "4.4.0",
    "next": "15.5.26",
    "next-intl": "^4.13.0",
    "qrcode": "^1.5.4",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^20.16.10",
    "@types/qrcode": "^1.5.5",
    "@types/react": "19.2.10",
    "@types/react-dom": "19.2.3",
    "autoprefixer": "^10.4.20",
    "postcss": "8.5.23",
    "tailwindcss": "^3.4.13",
    "typescript": "^5.6.2"
  }
}
