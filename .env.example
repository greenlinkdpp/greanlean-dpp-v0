# Public browser configuration. The anon key is public by design; RLS remains mandatory.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_PUBLIC_KEY
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Environment boundary: local | preview | test | production
DPP_ENVIRONMENT=local

# Additive architecture flags. Keep disabled until the matching migration and tests pass.
NEXT_PUBLIC_FEATURE_SCHEMA_REGISTRY=false
NEXT_PUBLIC_FEATURE_BATTERY_DPP_V2=false
FEATURE_SERVER_API_V2=false
FEATURE_V2_PUBLIC_READ=false
FEATURE_V2_TENANT_API=false
FEATURE_V2_PUBLICATION_WRITE=false
FEATURE_V2_CONNECTOR_EXECUTION=false
FEATURE_V2_PRODUCT_CORE=false
FEATURE_V2_SCHEMA_CORE=false
FEATURE_V2_CANONICAL_DATA=false
FEATURE_V2_PROVENANCE=false
FEATURE_V2_RESOLUTION_ENGINE=false
FEATURE_V2_DPP_PASSPORT=false
FEATURE_V2_DPP_REVIEW=false
FEATURE_V2_DPP_PUBLICATION=false
FEATURE_V2_RESOLVER=false
FEATURE_V2_PUBLIC_PROJECTION=false
FEATURE_V2_INTEGRATION_CORE=false
FEATURE_V2_FILE_IMPORT=false
FEATURE_V2_REGISTRY_TEST=false
FEATURE_V2_EXTERNAL_CONNECTORS=false
FEATURE_V2_BMS_ADAPTER=false
FEATURE_REGISTRY_ADAPTER=false

# Server-only credentials. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY

# Optional Registry test adapter settings. Production values must use the hosting secret store.
DPP_REGISTRY_ENVIRONMENT=test
DPP_REGISTRY_BASE_URL=
DPP_REGISTRY_CLIENT_ID=
DPP_REGISTRY_CLIENT_SECRET=
